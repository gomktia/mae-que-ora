n\\r\\n  window.addEventListener(\'scroll\', () => {\\r\\n    const now = Date.now();\\r\\n    const deltaY = window.scrollY - lastScrollY;\\r\\n    const deltaT = now - lastTime;\\r\\n\\r\\n    if (deltaY < -80 && deltaT < 400) {\\r\\n      if (timer) clearTimeout(timer);\\r\\n      timer = setTimeout(showPopup, DELAY_MS);\\r\\n    }\\r\\n\\r\\n    lastScrollY = window.scrollY;\\r\\n    lastTime = now;\\r\\n  });\\r\\n\\r\\n  \\/\\/ --- MOBILE: bot\\u00e3o voltar ---\\r\\n  window.addEventListener(\'popstate\', () => {\\r\\n    showPopup();\\r\\n    history.pushState(null, \'\', location.href);\\r\\n  });\\r\\n\\r\\n  history.pushState(null, \'\', location.href);\\r\\n})();\\r\\n<\\/script>\\r\\n"},"elements":[],"widgetType":"html"},{"id":"5dc1dd3c","elType":"widget","settings":{"title":"<span style=\\"color: #D8A05A;\\">ATEN\\u00c7\\u00c3O:<\\/span> Esta Mensagem \\u00e9 Para M\\u00e3es que Sentem Que Algo Precisa <span style=\\"color: #D8A05A;\\">Mudar na Vida dos Seus Filhos<\\/span>","align":"center","title_color":"#3B1B1B","typography_typography":"custom","typography_font_family":"Playfair","typography_font_size":{"unit":"px","size":46},"typography_font_size_mobile":{"unit":"px","size":35},"typography_font_weight":"900","typography_line_height":{"unit":"em","size":1.3},"_margin":{"unit":"px","top":"0","right":"0","bottom":"20","left":"0","isLinked":false}},"elements":[],"widgetType":"heading"},{"id":"033d846","elType":"widget","settings":{"html":"<script type=\\"text\\/javascript\\"> var s=document.createElement(\\"script\\"); s.src=\\"https:\\/\\/scripts.converteai.net\\/lib\\/js\\/smartplayer-wc\\/v4\\/sdk.js\\", s.async=!0,document.head.appendChild(s); <\\/script> <div id=\\"ifr_6976875aa19ff9c17f8fb644_wrapper\\" style=\\"margin: 0 auto; width: 100%; max-width: 400px;\\"> <div style=\\"position: relative; padding: 177.77777777777777% 0 0 0;\\" id=\\"ifr_6976875aa19ff9c17f8fb644_aspect\\"> <iframe frameborder=\\"0\\" allowfullscreen src=\\"about:blank\\" id